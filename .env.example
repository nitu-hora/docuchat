# DocuChat needs no API keys. Everything below is optional:
# these are the defaults, so the app works with no .env file at all.
# Docker Compose reads a .env file in this folder; local runs use the defaults.

# Where Ollama's OpenAI-compatible endpoint is
OLLAMA_URL=http://localhost:11434/v1/

# Model that writes the answers, and model that makes the embeddings
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# Folder where Chroma saves the index
DB_PATH=chroma_db

# 127.0.0.1 = only this computer. Docker sets 0.0.0.0 so the page is reachable.
GRADIO_SERVER_NAME=127.0.0.1

# Optional retrieval upgrades (see README). 0 = off, 1 = on.
HYBRID=0
RERANK=0
REWRITE=0
# RERANK=1 also needs: pip install sentence-transformers (not in the Docker image)
# How many candidate chunks each search hands on, and the re-ranker model
CANDIDATES=20
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
